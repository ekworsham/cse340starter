<main>
  <h1><%= title %></h1>
  <% if (messages && messages.notice) { %>
    <% messages.notice.forEach(function(msg){ %>
      <div class="flash"><%= msg %></div>
    <% }) %>
  <% } %>
  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(function(error) { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>
  
  <form id="loginForm" action="/account/login" method="post">
    <label for="account_email">Email</label>
    <input type="email" id="account_email" name="account_email" 
    required value="<%= typeof account_email !== 'undefined' ? account_email : '' %>">

    <label for="account_password">Password</label>
    <input 
      type="password" 
      id="account_password" 
      name="account_password" 
      required>

    <button id="loginButton" type="submit">Login</button>
    <p>Not a member? <a href="/account/register">Sign-Up</a></p>
  </form>
</main>