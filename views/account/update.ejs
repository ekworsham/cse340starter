<main>
  <h1><%= title %></h1>
  
  <% if (messages && messages.notice) { %>
    <% messages.notice.forEach(function(msg){ %>
      <div class="flash"><%= msg %></div>
    <% }) %>
  <% } %>
  
  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(function(error) { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <div class="update-forms-container">
    <!-- Account Update Form -->
    <div class="form-section">
      <h2>Account Update</h2>
      <form action="/account/update" method="post" id="updateForm" novalidate>
        <input type="hidden" name="account_id" value="<%= typeof accountData !== 'undefined' ? accountData.account_id : (typeof locals !== 'undefined' && locals.account_id ? locals.account_id : '') %>">
        
        <label for="account_firstname">First Name:</label>
        <input 
          type="text" 
          id="account_firstname" 
          name="account_firstname" 
          required 
          value="<%= typeof account_firstname !== 'undefined' ? account_firstname : (typeof accountData !== 'undefined' ? accountData.account_firstname : (typeof locals !== 'undefined' && locals.account_firstname ? locals.account_firstname : '')) %>"
        >
        
        <label for="account_lastname">Last Name:</label>
        <input 
          type="text" 
          id="account_lastname" 
          name="account_lastname" 
          required 
          value="<%= typeof account_lastname !== 'undefined' ? account_lastname : (typeof accountData !== 'undefined' ? accountData.account_lastname : (typeof locals !== 'undefined' && locals.account_lastname ? locals.account_lastname : '')) %>"
        >

        <label for="account_email">Email Address:</label>
        <input 
          type="email" 
          id="account_email" 
          name="account_email" 
          required 
          value="<%= typeof account_email !== 'undefined' ? account_email : (typeof accountData !== 'undefined' ? accountData.account_email : (typeof locals !== 'undefined' && locals.account_email ? locals.account_email : '')) %>"
        >
        
        <input type="submit" value="Update Account" id="updateButton">
      </form>
    </div>

    <!-- Change Password Form -->
    <div class="form-section">
      <h2>Change Password</h2>
      <p class="password-info">
        <strong>Note:</strong> Entering a new password will change your current password. 
        Password must be at least 12 characters long and contain at least one capital letter, 
        one number, and one special character (!@#$%^&*()_+-=[]{};\':"|,.<>/?).
      </p>
      <form action="/account/change-password" method="post" id="passwordForm" novalidate>
        <input type="hidden" name="account_id" value="<%= typeof accountData !== 'undefined' ? accountData.account_id : (typeof locals !== 'undefined' && locals.account_id ? locals.account_id : '') %>">
        
        <label for="account_password">New Password:</label>
        <input 
          type="password" 
          id="account_password" 
          name="account_password" 
          required 
          minlength="12" 
          pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':\\|,.<>\/?]).{12,}$"
          title="Password must be at least 12 characters, contain a capital letter, a number, and a special character."
        >
        
        <input type="submit" value="Change Password" id="passwordButton">
      </form>
    </div>
  </div>

  <p><a href="/account/">Return to Account Management</a></p>

  <script>
  // Client-side validation for Account Update Form
  document.getElementById('updateForm').addEventListener('submit', function(e) {
    let isValid = true;
    const firstName = document.getElementById('account_firstname');
    const lastName = document.getElementById('account_lastname');
    const email = document.getElementById('account_email');
    
    // Clear previous error styling
    [firstName, lastName, email].forEach(field => {
      field.style.borderColor = '';
    });
    
    // Validate first name
    if (!firstName.value.trim()) {
      firstName.style.borderColor = 'red';
      isValid = false;
    }
    
    // Validate last name
    if (!lastName.value.trim()) {
      lastName.style.borderColor = 'red';
      isValid = false;
    }
    
    // Validate email
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email.value.trim() || !emailPattern.test(email.value)) {
      email.style.borderColor = 'red';
      isValid = false;
    }
    
    if (!isValid) {
      e.preventDefault();
      alert('Please fill in all required fields correctly.');
    }
  });

  // Client-side validation for Password Change Form
  document.getElementById('passwordForm').addEventListener('submit', function(e) {
    const password = document.getElementById('account_password');
    const passwordPattern = /^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':\\|,.<>\/?]).{12,}$/;
    
    // Clear previous error styling
    password.style.borderColor = '';
    
    if (!password.value || !passwordPattern.test(password.value)) {
      password.style.borderColor = 'red';
      e.preventDefault();
      alert('Password must be at least 12 characters long and contain at least one capital letter, one number, and one special character.');
    }
  });
  </script>
</main>