<main>
  <h1><%= title %></h1>
  <% if (messages && messages.notice) { %>
    <% messages.notice.forEach(function(msg){ %>
      <div class="flash"><%= msg %></div>
    <% }) %>
  <% } %>
  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(function(error) { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/account/register" method="post" id="registerForm">
    <label for="account_firstname">First Name</label>
    <input type="text" id="account_firstname" name="account_firstname" required value="<%= typeof account_firstname !== 'undefined' ? account_firstname : '' %>">
    
    <label for="account_lastname">Last Name</label>
    <input type="text" id="account_lastname" name="account_lastname" required value="<%= typeof account_lastname !== 'undefined' ? account_lastname : '' %>">

    <label for="account_email">Email address</label>
    <input type="email" id="account_email" name="account_email" required value="<%= typeof account_email !== 'undefined' ? account_email : '' %>">

    <label for="account_password">Password</label>
    <input 
        type="password" 
        id="account_password" 
        name="account_password" 
        required 
        minlength="12" 
        pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':\\|,.<>\/?]).{12,}$"
        title="Password must be at least 12 characters, contain a capital letter, a number, and a special character."
    >
    
    <p style="color: black !important; font-size: 14px !important; margin: 10px 0 !important; text-align: center !important; background-color: yellow !important; padding: 10px !important; border: 3px solid red !important; border-radius: 5px !important; display: block !important;">
      <strong>Password Requirements: At least 12 characters with 1 uppercase, 1 lowercase, 1 number, and 1 symbol.</strong>
    </p>
    
    <button id="registerButton" type="submit">Register</button>
    <p>Already have an account? <a href="/account/login">Sign In</a></p>
  </form>
</main>